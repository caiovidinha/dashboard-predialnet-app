# URL base da API (sem barra no final)
API_URL=https://appgw.predialnet.com.br

# Token do dashboard do operador — o mesmo ADMIN_BYPASS_TOKEN do backend.
# NUNCA prefixe com NEXT_PUBLIC_: isso vazaria o token para o navegador.
# Ele é usado apenas em Server Component, server-to-server.
ADMIN_TOKEN=

# Login do painel (tela /login, com um botão por área). Gere com:
#   openssl rand -base64 24
# DASHBOARD_SENHA  → "Painel do app": vê o painel do app E as parcerias.
# PARCERIAS_SENHA  → "Parcerias": vê SÓ a tela de parcerias.
# Área com senha vazia não abre. As duas vazias = painel aberto (só dev/rede fechada).
DASHBOARD_SENHA=
PARCERIAS_SENHA=

# Segredo que assina o cookie de sessão (12 h). Opcional: sem ele, deriva das
# senhas acima (trocar uma senha derruba as sessões abertas).
SESSAO_SEGREDO=
