# URL base da API (sem barra no final)
API_URL=https://appgw.predialnet.com.br

# Token do dashboard do operador — o mesmo ADMIN_BYPASS_TOKEN do backend.
# NUNCA prefixe com NEXT_PUBLIC_: isso vazaria o token para o navegador.
# Ele é usado apenas em Server Component, server-to-server.
ADMIN_TOKEN=

# Autenticação básica do próprio dashboard.
# Vazio = página aberta a quem tiver a URL. Preencha, a menos que ele vá rodar
# em rede fechada. Gere com: openssl rand -base64 24
DASHBOARD_USUARIO=predialnet
DASHBOARD_SENHA=
